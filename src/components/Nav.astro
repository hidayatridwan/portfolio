---
import { navLinks } from '../data/navigation';
import { site, mailto } from '../data/site';
---

<nav class="nav" id="nav">
  <div class="wrap nav-inner">
    <a href="#home" class="brand serif">{site.shortName}.</a>
    <ul class="nav-links">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href={mailto} class="btn-pill nav-cta">Contact</a>
    <button
      class="menu-toggle"
      id="menuToggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease);
  }
  .nav.solid {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 rgba(15, 15, 15, 0.06), 0 14px 40px -28px rgba(15, 15, 15, 0.4);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }
  .brand {
    font-size: 27px;
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 34px;
    list-style: none;
  }
  .nav-links a {
    font-size: 15px;
    color: var(--ink);
    opacity: 0.78;
    position: relative;
    padding: 4px 0;
    transition: opacity 0.25s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 1.5px;
    background: var(--ink);
    transition: right 0.3s var(--ease);
  }
  .nav-links a:hover {
    opacity: 1;
  }
  .nav-links a:hover::after {
    right: 0;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    padding: 0;
    position: relative;
    z-index: 60;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ink);
    margin: 5px auto;
    border-radius: 2px;
    transition: transform 0.35s var(--ease), opacity 0.25s var(--ease);
  }
  .menu-toggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .nav-links {
      gap: 26px;
    }
  }
  @media (max-width: 900px) {
    .nav-inner {
      height: 72px;
    }
    .nav-links,
    .nav-cta {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span {
      transition: none !important;
    }
  }
</style>
