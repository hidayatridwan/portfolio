---
import { navLinks } from '../data/navigation';
import { site, mailto } from '../data/site';
---

<div class="m-menu" id="mobileMenu" aria-hidden="true">
  <nav class="m-menu-links" aria-label="Mobile">
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="m-menu-foot">
    <a href={mailto} class="btn-pill">Email me</a>
    <div class="m-menu-meta">
      <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.social.github} target="_blank" rel="noopener">GitHub</a>
      <span>{site.location}</span>
    </div>
  </div>
</div>

<style>
  .m-menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: linear-gradient(170deg, #fff7ec, #ffe9cf 55%, #ffdcb4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding: 96px 32px 48px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), visibility 0.4s;
  }
  .m-menu.open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .m-menu-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .m-menu-links a {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(38px, 11vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    opacity: 0;
    transform: translateX(-14px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .m-menu.open .m-menu-links a {
    opacity: 1;
    transform: none;
  }
  .m-menu.open .m-menu-links a:nth-child(1) {
    transition-delay: 0.08s;
  }
  .m-menu.open .m-menu-links a:nth-child(2) {
    transition-delay: 0.13s;
  }
  .m-menu.open .m-menu-links a:nth-child(3) {
    transition-delay: 0.18s;
  }
  .m-menu.open .m-menu-links a:nth-child(4) {
    transition-delay: 0.23s;
  }
  .m-menu.open .m-menu-links a:nth-child(5) {
    transition-delay: 0.28s;
  }
  .m-menu.open .m-menu-links a:nth-child(6) {
    transition-delay: 0.33s;
  }
  .m-menu-foot {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .m-menu-foot .btn-pill {
    padding: 15px 30px;
    font-size: 16px;
  }
  .m-menu-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 15px;
    color: var(--muted);
  }
  .m-menu-meta a:hover {
    color: var(--ink);
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-menu,
    .m-menu-links a {
      transition: none !important;
    }
  }
</style>
