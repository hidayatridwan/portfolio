---
import { services } from '../data/services';
---

<section class="sec-pad" id="services">
  <div class="wrap">
    <h2 class="kicker reveal">I can help<br />you with</h2>
    <div class="services">
      {
        services.map((service, i) => (
          <div class="svc reveal" data-d={i * 90}>
            <div class="svc-idx">{String(i + 1).padStart(2, '0')}</div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 56px;
  }
  .svc {
    position: relative;
    padding: 8px 30px 0;
  }
  .svc + .svc {
    border-left: 1px solid var(--line);
  }
  .svc-idx {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 58px;
    color: #0000;
    -webkit-text-stroke: 1.4px var(--faint);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .svc h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    margin: 64px 0 14px;
    letter-spacing: -0.01em;
  }
  .svc p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .services {
      grid-template-columns: 1fr 1fr;
      gap: 30px 0;
    }
    .svc {
      padding: 8px 22px;
    }
    .svc:nth-child(3) {
      border-left: none;
    }
    .svc h3 {
      margin-top: 30px;
    }
  }
  @media (max-width: 560px) {
    .services {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .svc {
      padding: 24px 0;
      border-left: none !important;
    }
    .svc + .svc {
      border-top: 1px solid var(--line);
    }
    .svc-idx {
      font-size: 46px;
    }
    .svc h3 {
      margin-top: 18px;
    }
  }
</style>
