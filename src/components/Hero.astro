---
import { Image } from 'astro:assets';
import profile from '../assets/profile.png';
import { site } from '../data/site';
---

<header class="hero" id="home">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hey-row">
      <span class="hey reveal" data-d="0">Hey,</span>
      <div class="portrait reveal" data-d="120">
        <Image
          src={profile}
          alt={`Portrait of ${site.name}`}
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="there reveal" data-d="60">there</span>
    </div>

    <div class="badge reveal" data-d="320">
      <span class="dot"></span>
      {site.availability}
    </div>
    <p class="hero-blurb reveal" data-d="380">{site.description}</p>

    <div class="hero-foot">
      <h1 class="iam reveal" data-d="220">I am<br />{site.shortName}</h1>
      <p class="role reveal" data-d="280">
        {site.roleLines.map((line) => <span>{line}</span>)}
      </p>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-top: 84px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 90% at 50% 18%, rgba(255, 255, 255, 0.35) 0%, transparent 60%),
      radial-gradient(150% 120% at 50% 100%, #ffd9a8 0%, #ffe9cf 32%, #fff7ec 60%, #ffffff 88%);
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 50% 42%, rgba(242, 107, 33, 0.1), transparent 70%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding: 30px 0 64px;
  }
  .hey-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hey,
  .there {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 380;
    font-size: clamp(74px, 15.5vw, 232px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .hey {
    margin-right: max(-2vw, -40px);
  }
  .there {
    margin-left: max(-2vw, -40px);
  }
  .portrait {
    position: relative;
    z-index: 3;
    width: clamp(280px, 38vw, 520px);
    margin: -2vw -3vw -64px;
    align-self: flex-end;
    filter: drop-shadow(0 40px 60px rgba(60, 30, 0, 0.28));
    pointer-events: none;
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 1;
    /* Head stays sharp & opaque; the body dissolves from the neck down,
       strongest at the bottom and the lower corners. */
    -webkit-mask-image: radial-gradient(
        ellipse 50% 80% at 50% 30%,
        #000 0%,
        #000 44%,
        rgba(0, 0, 0, 0.3) 74%,
        transparent 99%
      ),
      linear-gradient(to bottom, #000 0%, #000 44%, rgba(0, 0, 0, 0.45) 70%, transparent 95%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    mask-image: radial-gradient(
        ellipse 50% 80% at 50% 30%,
        #000 0%,
        #000 44%,
        rgba(0, 0, 0, 0.3) 74%,
        transparent 99%
      ),
      linear-gradient(to bottom, #000 0%, #000 44%, rgba(0, 0, 0, 0.45) 70%, transparent 95%);
  }
  /* Hero portrait: clean fade-in from zero on first load. */
  .portrait.reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.5s var(--ease), transform 1.5s var(--ease);
  }
  .portrait.reveal.in {
    opacity: 1;
    transform: none;
  }
  .hero-foot {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 30px;
    margin-top: -2vw;
  }
  .iam {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(58px, 11vw, 148px);
    line-height: 0.84;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .role {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(20px, 2.4vw, 34px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: right;
  }
  .role span {
    display: block;
  }
  .badge {
    position: absolute;
    left: 0;
    top: 46%;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(15, 15, 15, 0.07);
    padding: 11px 20px 11px 16px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    box-shadow: 0 18px 40px -24px rgba(60, 30, 0, 0.5);
  }
  .hero-blurb {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 5;
    max-width: 240px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .hero-blurb {
      max-width: 200px;
      font-size: 14px;
    }
  }
  @media (max-width: 900px) {
    .hero {
      padding-top: 72px;
    }
    .hey-row {
      flex-direction: column;
    }
    .hey {
      margin: 0;
    }
    .there {
      margin: 0;
      order: 3;
    }
    .portrait {
      order: 2;
      /* Reset desktop's `align-self: flex-end` — in a column it means the right
         edge, which pushed the portrait off-centre. */
      align-self: center;
      /* Smaller negative top margin → sits a little lower, less overlap with "Hey". */
      margin: 2vw 0 0;
      width: min(72vw, 360px);
    }
    .hero-foot {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 14px;
      margin-top: 28px;
    }
    .iam,
    .role {
      text-align: center;
    }
    .badge {
      position: static;
      margin: 44px auto 0;
      display: flex;
      width: max-content;
    }
    .hero-blurb {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hey,
    .there {
      font-size: clamp(58px, 20vw, 90px);
    }
  }
</style>
